{
  "manifest_version": 3,
  "name": "Memecord - Chrome Extension for Video Call Memes",
  "version": "1.2.0",
  "description": "Chrome extension to trigger meme overlays on your live camera feed & screen across video call websites in Chrome (Google Meet, Discord Web, Zoom, Teams, Slack, FaceTime).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Memecord Settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://discord.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.slack.com/*",
    "https://facetime.apple.com/*",
    "https://web.whatsapp.com/*",
    "https://api.imgflip.com/*",
    "https://meme-api.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://discord.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.slack.com/*",
        "https://facetime.apple.com/*",
        "https://web.whatsapp.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://discord.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.slack.com/*",
        "https://facetime.apple.com/*",
        "https://web.whatsapp.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "memes/*",
        "icons/*",
        "assets/*"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://discord.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.slack.com/*",
        "https://facetime.apple.com/*",
        "https://web.whatsapp.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
