{
  "manifest_version": 3,
  "name": "MemeMeet - Google Meet Gesture Memes",
  "version": "1.0.0",
  "description": "Trigger fun meme overlays in Google Meet with hand gestures.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "MemeMeet Settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://meet.google.com/*",
    "https://api.imgflip.com/*",
    "https://meme-api.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "memes/*",
        "models/*",
        "mediapipe/wasm/*",
        "icons/*",
        "test/index.html",
        "assets/*"
      ],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
